PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Optional: Hugging Face token for the server-side /api/scan proxy.
# Get one free at https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Gemini key for the smart /api/gemini-scan (knows Indonesian food).
# Free key at https://aistudio.google.com — models fail over automatically.
# GEMINI_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Tiered Gemini concurrency: 1-40 = GEMINI heavy, 41-80 = GEMINI lite (cheap), >80 = Puter AI auto-fallback (anti-down)
# GEMINI_USER_LIMIT=40
# GEMINI_LITE_LIMIT=80
# Optional: override model chains (first = primary)
# GEMINI_MODELS=gemini-3-flash-preview,gemini-flash-latest,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
# GEMINI_LITE_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite
